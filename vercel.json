{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/health.py" },
    { "src": "/predict", "dest": "/api/predict.py" },
    { "src": "/predict_rice", "dest": "/api/predict_rice.py" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}